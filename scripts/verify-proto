#!/usr/bin/env sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
runtime_root="$repository_root/runtime"

echo "Protobuf verification"

if ! find "$runtime_root/proto" -name '*.proto' -print -quit | grep -q .; then
  echo "  not configured: no protobuf contracts found"
  exit 0
fi

command -v uv >/dev/null 2>&1 || {
  echo "  failed: uv is required"
  exit 1
}

cd "$runtime_root"
temporary_directory=$(mktemp -d)
trap 'rm -rf "$temporary_directory"' EXIT

knowledge_environment="$runtime_root/src/knowledge/api/.venv"
UV_PROJECT_ENVIRONMENT="$knowledge_environment" uv sync --frozen --inexact
uv pip install \
  --python "$knowledge_environment/bin/python" \
  --requirement src/knowledge/api/requirements.txt

"$knowledge_environment/bin/python" -m grpc_tools.protoc \
  --proto_path=proto \
  --python_out="$temporary_directory" \
  --pyi_out="$temporary_directory" \
  --grpc_python_out="$temporary_directory" \
  proto/knowledge/v1/knowledge.proto

for generated_file in knowledge_pb2.py knowledge_pb2.pyi knowledge_pb2_grpc.py; do
  diff \
    "$temporary_directory/knowledge/v1/$generated_file" \
    "src/knowledge/shared/knowledge/v1/$generated_file"
done
