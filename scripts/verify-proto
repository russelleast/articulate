#!/usr/bin/env sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

echo "Protobuf verification"

if ! find "$repository_root" \
  -path '*/.git' -prune -o \
  -path '*/node_modules' -prune -o \
  -name '*.proto' -print -quit | grep -q .; then
  echo "  not configured: no protobuf contracts found"
  exit 0
fi

command -v uv >/dev/null 2>&1 || {
  echo "  failed: uv is required"
  exit 1
}

cd "$repository_root"
temporary_directory=$(mktemp -d)
trap 'rm -rf "$temporary_directory"' EXIT

uv run python -m grpc_tools.protoc \
  --proto_path=proto \
  --python_out="$temporary_directory" \
  --pyi_out="$temporary_directory" \
  --grpc_python_out="$temporary_directory" \
  proto/knowledge/v1/knowledge.proto

for generated_file in knowledge_pb2.py knowledge_pb2.pyi knowledge_pb2_grpc.py; do
  diff \
    "$temporary_directory/knowledge/v1/$generated_file" \
    "src/shared/knowledge/v1/$generated_file"
done
