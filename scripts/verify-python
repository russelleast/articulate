#!/usr/bin/env sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
runtime_root="$repository_root/runtime"

echo "Python verification"

if [ ! -f "$runtime_root/pyproject.toml" ]; then
  echo "  not configured: no Python project found"
  exit 0
fi

command -v uv >/dev/null 2>&1 || {
  echo "  failed: uv is required"
  exit 1
}

cd "$runtime_root"
uv lock --check

knowledge_environment="$runtime_root/src/knowledge/api/.venv"
claim_simulator_environment="$runtime_root/src/tools/claim_simulator/.venv"
review_agent_environment="$runtime_root/src/knowledge/agents/review_proposed_claim/.venv"

UV_PROJECT_ENVIRONMENT="$knowledge_environment" uv sync --frozen --inexact
uv pip install \
  --python "$knowledge_environment/bin/python" \
  --requirement src/knowledge/api/requirements.txt

UV_PROJECT_ENVIRONMENT="$claim_simulator_environment" uv sync --frozen --inexact
uv pip install \
  --python "$claim_simulator_environment/bin/python" \
  --requirement src/tools/claim_simulator/requirements.txt

UV_PROJECT_ENVIRONMENT="$review_agent_environment" uv sync --frozen --inexact
uv pip install \
  --python "$review_agent_environment/bin/python" \
  --requirement src/knowledge/agents/review_proposed_claim/requirements.txt

"$knowledge_environment/bin/ruff" format --check \
  src/knowledge/api src/tools/claim_simulator src/knowledge/agents/review_proposed_claim
"$knowledge_environment/bin/ruff" check \
  src/knowledge/api src/tools/claim_simulator src/knowledge/agents/review_proposed_claim
"$knowledge_environment/bin/pyright" --pythonpath "$knowledge_environment/bin/python" src/knowledge/api
"$claim_simulator_environment/bin/pyright" \
  --pythonpath "$claim_simulator_environment/bin/python" \
  src/tools/claim_simulator
"$review_agent_environment/bin/pyright" \
  --pythonpath "$review_agent_environment/bin/python" \
  src/knowledge/agents/review_proposed_claim
"$knowledge_environment/bin/pytest" src/knowledge/api/tests
"$claim_simulator_environment/bin/pytest" src/tools/claim_simulator/tests
"$review_agent_environment/bin/pytest" src/knowledge/agents/review_proposed_claim/tests
