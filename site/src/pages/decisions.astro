---
import { getCollection, render } from "astro:content";
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import MetadataList from "@/components/MetadataList.astro";
import { formatDate, withBase } from "@/utils/site";

const episodes = await getCollection("episodes", ({ data }) => data.isPublished);
const decisions = await Promise.all(
  (await getCollection("decisions"))
    .sort((a, b) => (b.data.decided?.valueOf() ?? 0) - (a.data.decided?.valueOf() ?? 0))
    .map(async (decision) => ({ ...decision, rendered: await render(decision) }))
);
---

<ArticleLayout
  title="Architecture Decisions"
  description="A readable index of architectural decisions, their status, dates, and relationships."
  eyebrow="Decision record"
>
  <p>
    Decisions are not raw ADR mirrors. This index provides context for the commitments that shape
    Articulate and connects them back to Episodes and repository evidence.
  </p>

  {decisions.length === 0 ? (
    <div class="empty-state">
      <h2>No architecture decisions have been published yet</h2>
      <p>
        ADRs will appear here after they exist in the project record. The site should not publish
        decisions ahead of the Episodes and evidence that produce them.
      </p>
    </div>
  ) : (
    <div class="timeline-list">
      {decisions.map((decision) => (
      <article id={decision.data.id}>
        <p class="item-meta">
          {decision.data.id} / {decision.data.status}
          {decision.data.decided && ` / ${formatDate(decision.data.decided)}`}
        </p>
        <h2>{decision.data.title}</h2>
        <MetadataList
          items={[
            {
              label: "Related Episodes",
              value: decision.data.related_episodes.length > 0
                ? decision.data.related_episodes
                    .map((reference) => episodes.find((episode) => episode.id === reference.id)?.data.sequence)
                    .filter((sequence) => sequence !== undefined)
                    .map((sequence) => `Episode ${sequence?.toString().padStart(4, "0")}`)
                    .join(", ")
                : "None yet"
            },
            { label: "Supersedes", value: decision.data.supersedes?.id ?? "None" },
            { label: "Superseded by", value: decision.data.superseded_by?.id ?? "None" }
          ]}
        />
        <ul class="tag-list">
          {decision.data.topics.map((topic) => <li>{topic}</li>)}
        </ul>
        {decision.data.related_episodes.length > 0 && (
          <ul class="plain-list">
            {decision.data.related_episodes.map((reference) => {
              const episode = episodes.find((entry) => entry.id === reference.id);
              return episode && (
                <li>
                  <a href={withBase(`/episodes/${episode.id}/`)}>
                    Episode {episode.data.sequence.toString().padStart(4, "0")} — {episode.data.title}
                  </a>
                </li>
              );
            })}
          </ul>
        )}
        <div class="decision-body">
          <decision.rendered.Content />
        </div>
      </article>
      ))}
    </div>
  )}
</ArticleLayout>
