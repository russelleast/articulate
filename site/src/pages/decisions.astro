---
import { getCollection } from "astro:content";
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import ArchitecturalRecordCard from "@/components/ArchitecturalRecordCard.astro";
import { formatDate, withBase } from "@/utils/site";

const episodes = await getCollection("episodes", ({ data }) => data.isPublished);
const decisions = (await getCollection("decisions"))
  .sort((a, b) => b.data.id.localeCompare(a.data.id));
---

<ArticleLayout
  title="Architecture Decisions"
  description="A readable index of architectural decisions, their status, dates, and relationships."
  eyebrow="Decision record"
>
  <p>
    Decisions are not raw ADR mirrors. This index provides context for the commitments that shape
    Articulate and connects them back to Episodes and repository evidence.
  </p>

  {decisions.length === 0 ? (
    <div class="empty-state">
      <h2>No architecture decisions have been published yet</h2>
      <p>
        ADRs will appear here after they exist in the project record. The site should not publish
        decisions ahead of the Episodes and evidence that produce them.
      </p>
    </div>
  ) : (
    <div class="record-list">
      {decisions.map((decision) => {
        const related = decision.data.related_episodes.flatMap((reference) => {
          const episode = episodes.find((entry) => entry.id === reference.id);
          return episode ? [{
            title: `Episode ${episode.data.sequence.toString().padStart(4, "0")}`,
            href: withBase(`/episodes/${episode.id}/`)
          }] : [];
        });

        return <ArchitecturalRecordCard
          eyebrow={`${decision.data.id.toUpperCase()}${decision.data.decided ? ` / ${formatDate(decision.data.decided)}` : ""}`}
          title={decision.data.title}
          summary={decision.data.summary}
          status={decision.data.status}
          href={withBase(`/decisions/${decision.data.id}/`)}
          linkLabel="Read the full decision"
          related={related}
        />;
      })}
    </div>
  )}
</ArticleLayout>
