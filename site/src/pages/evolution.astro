---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { withBase } from "@/utils/site";
import { evolutionMilestones } from "@/data/evolution";
---

<ArticleLayout
  title="Architectural Evolution"
  description="A timeline of architectural phases, significant problems, changes, decisions, and evidence."
  eyebrow="Evolution"
>
  <p>
    This is an architecture timeline, not a release log or a second Episode index. It traces the
    moments when the project’s understanding changed: the problems reframed, responsibilities
    separated, and durable architectural commitments that followed.
  </p>

  <div class="timeline-list">
    {evolutionMilestones.map((milestone) => (
      <article class="evolution-milestone">
        <p class="item-meta">{milestone.period}</p>
        <h2>{milestone.title}</h2>
        <p>{milestone.description}</p>
        <ul class="evolution-links" aria-label={`Evidence for ${milestone.title}`}>
          {milestone.links.map((link) => (
            <li><span>{link.type}</span><a href={withBase(link.href)}>{link.label}</a></li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</ArticleLayout>
