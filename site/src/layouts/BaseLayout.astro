---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Analytics from "@/components/Analytics.astro";
import Seo from "@/components/Seo.astro";
import { siteDescription, withBase } from "@/utils/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  type?: "website" | "article";
  image?: string;
  author?: string;
  article?: {
    published?: Date;
    updated?: Date;
    tags?: string[];
  };
  structuredType?: "Article" | "TechArticle" | "CreativeWork";
  breadcrumbs?: Array<{ name: string; path: string }>;
  analytics?: {
    contentType: "page" | "episode";
    episode?: string;
    series?: string;
  };
}

const { analytics = { contentType: "page" }, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-H9ZZ7JCZR2"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-H9ZZ7JCZR2');
    </script>

    <script is:inline type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "xx5vmbeeqa");
  </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...seo} description={seo.description ?? siteDescription} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <Analytics
      contentType={analytics.contentType}
      episode={analytics.episode}
      series={analytics.series}
    />
  </head>
  <body
    data-content-type={analytics.contentType}
    data-episode={analytics.episode}
    data-series={analytics.series}
  >
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
