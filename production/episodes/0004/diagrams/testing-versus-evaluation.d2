...@../../../diagrams/styles/articulate
direction: right

system: "AI-native system" { class: service }
testing: "Testing" {
  class: boundary
  unit: "Unit" { class: evidence }
  integration: "Integration" { class: evidence }
  contract: "Contract" { class: evidence }
}
evaluation: "Evaluation" {
  class: boundary
  correct: "Correct?" { class: quality }
  grounded: "Grounded?" { class: quality }
  safe: "Safe?" { class: quality }
}
implementation: "Implementation works" { class: quality }
behaviour: "Behaviour is good" { class: quality }

system -> testing: verifies
testing -> implementation: evaluates
system -> evaluation: observes
evaluation -> behaviour: evaluates
