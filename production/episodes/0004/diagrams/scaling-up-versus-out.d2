...@../../../diagrams/styles/articulate
direction: right

question: "Where should complexity live?" { class: decision }
up: "Scale up" {
  class: boundary
  agent: "One coherent agent" { class: agent }
  context: "Shared context" { class: data }
  pressure: "Internal pressure" { class: constraint }
  agent -> context: consumes
  context -> pressure: produces
}
out: "Scale out" {
  class: boundary
  router: "Coordination" { class: router }
  agents: "Specialist agents" { class: agent }
  boundary: "Boundary costs" { class: constraint }
  router -> agents: routes to
  agents -> boundary: produces
}

question -> up: concentrates
question -> out: distributes
