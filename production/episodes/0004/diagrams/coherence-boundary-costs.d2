...@../../../diagrams/styles/articulate
direction: right

principle: "Coherence Before Size" { class: principle }
responsibility: "Coherent responsibility" { class: capability }
decision: "Responsibilities diverge?" { class: decision }
boundary: "New boundary" { class: boundary }
costs: {
  grid-columns: 3
  routing: "Routing" { class: constraint }
  context: "Context" { class: constraint }
  trust: "Trust" { class: constraint }
  failure: "Failure" { class: constraint }
  evaluation: "Evaluation" { class: constraint }
}

principle -> responsibility: protects
responsibility -> decision: evaluates
decision -> boundary: justifies
boundary -> costs: introduces
