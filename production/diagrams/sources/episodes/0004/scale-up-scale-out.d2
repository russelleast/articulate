direction: right

scale_up: "SCALE UP" {
  direction: down
  agent: "One coherent agent" {
    shape: circle
  }
  responsibility: "Broader responsibility"
  context: "Shared context"
  inference: "Larger inference"

  agent -> responsibility
  responsibility -> context
  context -> inference
}

question: "WHERE SHOULD\nCOMPLEXITY LIVE?" {
  shape: diamond
  style.fill: "#ead8cd"
}

scale_out: "SCALE OUT" {
  direction: down
  specialists: "Specialised agents"
  routing: "Routing + coordination"
  context: "Context transfer"
  failure: "Partial failure"

  specialists -> routing
  routing -> context
  context -> failure
}

scale_up -> question
question -> scale_out
