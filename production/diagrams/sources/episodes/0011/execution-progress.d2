...@../../../styles/articulate
direction: right
knowledge: "RECONSTRUCT KNOWING\nretrieve again" {class: capability}
execution: "RECONSTRUCT DOING?\nunsafe to repeat" {class: emphasis}
tool: "Tool already called" {class: node}
state: "State already updated" {class: evidence}
approval: "Approval requested" {class: capability}
effect: "External effect occurred" {class: service}
