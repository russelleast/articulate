@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 20
skinparam defaultFontColor #17232D
skinparam rectangle {
  BackgroundColor #F7F4ED
  BorderColor #49677C
  FontColor #17232D
  RoundCorner 18
}
skinparam ArrowColor #0D32B2
skinparam ArrowFontSize 17
left to right direction

circle "Change" as start #176B62
rectangle "Proposed\nKnowledge" as proposed
rectangle "Interpret and\nReconcile" as interpret
rectangle "Architectural\nAssurance" as assurance #DCEBE7
rectangle "Findings" as findings #F3E3DE
rectangle "Human\nJudgement" as human_review
rectangle "Disposition" as disposition #E8EDF2

rectangle "Merge" as merge #DCEBE7
rectangle "Revise" as revise
rectangle "Reject" as reject
rectangle "Defer" as defer
circle "Accepted" as accepted #4A6FF3
circle "Rework" as rework #4A6FF3
circle "Closed" as closed #4A6FF3
circle "Parked" as parked #4A6FF3

start --> proposed
proposed --> interpret
interpret --> assurance
assurance --> findings
findings --> human_review
human_review --> disposition
disposition --> merge
disposition --> revise
disposition --> reject
disposition --> defer
merge --> accepted
revise --> rework
reject --> closed
defer --> parked
@enduml
