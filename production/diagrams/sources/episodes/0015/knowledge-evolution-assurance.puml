@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor #17232D
skinparam activity {
  BackgroundColor #F7F4ED
  BorderColor #263746
  FontColor #17232D
  DiamondBackgroundColor #E8EDF2
  DiamondBorderColor #49677C
  StartColor #176B62
  EndColor #176B62
  BarColor #49677C
}
skinparam ArrowColor #0D32B2

start
:Proposed Knowledge;
:Interpretation;
:Reconciliation;
:Validation;
:Architectural Assurance; <<#DCEBE7>>
note right
  Assurance occurs before proposed knowledge
  can enter the authoritative model.
end note
:Findings and Calls to Action;
:Human Judgement;

switch (Disposition)
case (Merge)
  :Merge; <<#DCEBE7>>
  :Authoritative Knowledge;
  stop
case (Revise)
  :Revise;
  stop
case (Reject)
  :Reject;
  stop
case (Defer)
  :Defer;
  stop
endswitch
@enduml
