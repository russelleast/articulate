@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 22
skinparam defaultFontColor #17232D
skinparam rectangle {
  BackgroundColor #F7F4ED
  BorderColor #49677C
  FontColor #17232D
  RoundCorner 18
}
skinparam ArrowColor #0D32B2
skinparam ArrowFontSize 18
left to right direction

circle "Intent" as start #176B62
rectangle "Capability\nIntent" as intent
rectangle "DCL\nDefinition" as dcl
rectangle "Capability\nAssurance" as assurance #DCEBE7
rectangle "Findings and\nDiscovery Questions" as findings #F3E3DE
rectangle "Refined\nCapability Intent" as refined
circle "Ready" as ready #4A6FF3

start --> intent
intent --> dcl
dcl --> assurance
assurance --> findings
findings --> refined
refined --> ready : sufficient
refined -up-> dcl : clarify
@enduml
