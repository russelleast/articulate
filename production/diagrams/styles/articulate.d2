# Shared Articulate diagram primitives. Individual diagrams may override any style.
classes: {
  node: {
    shape: rectangle
    style: {
      fill: "#F7F4ED"
      stroke: "#263746"
      stroke-width: 2
      border-radius: 8
      font-color: "#17232D"
      font-size: 22
    }
  }
  emphasis: {
    shape: rectangle
    style: {
      fill: "#DCEBE7"
      stroke: "#176B62"
      stroke-width: 3
      border-radius: 8
      font-color: "#103D39"
      font-size: 24
      bold: true
    }
  }
  capability: {
    shape: rectangle
    style: {
      fill: "#E8EDF2"
      stroke: "#49677C"
      stroke-width: 2
      border-radius: 8
      font-color: "#17232D"
      font-size: 20
    }
  }
  agent: {
    shape: hexagon
    style: {
      fill: "#DCEBE7"
      stroke: "#176B62"
      stroke-width: 3
      font-color: "#103D39"
      font-size: 21
    }
  }
  service: {
    shape: rectangle
    style: {
      fill: "#E8EDF2"
      stroke: "#49677C"
      stroke-width: 2
      border-radius: 4
      font-color: "#17232D"
      font-size: 20
    }
  }
  workflow: {
    shape: queue
    style: {
      fill: "#E8EDF2"
      stroke: "#49677C"
      stroke-width: 2
      font-color: "#17232D"
      font-size: 20
    }
  }
  data: {
    shape: cylinder
    style: {
      fill: "#EDE7F2"
      stroke: "#665278"
      stroke-width: 2
      font-color: "#30243A"
      font-size: 20
    }
  }
  external: {
    shape: rectangle
    style: {
      fill: "#FFFFFF"
      stroke: "#687681"
      stroke-width: 2
      stroke-dash: 5
      font-color: "#374550"
      font-size: 20
    }
  }
  human: {
    shape: person
    style: {
      fill: "#F2E8D8"
      stroke: "#8A6235"
      stroke-width: 2
      font-color: "#49321E"
      font-size: 20
    }
  }
  policy: {
    shape: document
    style: {
      fill: "#F7F4ED"
      stroke: "#8A6235"
      stroke-width: 2
      font-color: "#49321E"
      font-size: 19
    }
  }
  constraint: {
    shape: diamond
    style: {
      fill: "#F3E3DE"
      stroke: "#984E43"
      stroke-width: 2
      font-color: "#512922"
      font-size: 19
    }
  }
  quality: {
    shape: oval
    style: {
      fill: "#DCEBE7"
      stroke: "#176B62"
      stroke-width: 2
      font-color: "#103D39"
      font-size: 20
    }
  }
  principle: {
    shape: hexagon
    style: {
      fill: "#EAD8CD"
      stroke: "#85543B"
      stroke-width: 3
      font-color: "#492C1E"
      font-size: 22
      bold: true
    }
  }
  decision: {
    shape: diamond
    style: {
      fill: "#EAD8CD"
      stroke: "#85543B"
      stroke-width: 2
      font-color: "#492C1E"
      font-size: 20
    }
  }
  event: {
    shape: oval
    style: {
      fill: "#FFFFFF"
      stroke: "#49677C"
      stroke-width: 2
      font-color: "#17232D"
      font-size: 19
    }
  }
  boundary: {
    shape: rectangle
    style: {
      fill: transparent
      stroke: "#687681"
      stroke-width: 2
      stroke-dash: 6
      font-color: "#374550"
      font-size: 19
    }
  }
  router: {
    shape: diamond
    style: {
      fill: "#E8EDF2"
      stroke: "#49677C"
      stroke-width: 3
      font-color: "#17232D"
      font-size: 20
    }
  }
  evidence: {
    shape: rectangle
    style: {
      fill: "#F2E8D8"
      stroke: "#8A6235"
      stroke-width: 2
      border-radius: 8
      font-color: "#49321E"
      font-size: 21
    }
  }
}
